{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "8K Gaming Mouse Control Center",
  "version": "0.1.1",
  "identifier": "com.huaxuan.gamingmouse",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "8K Gaming Mouse Control Center",
      "width": 1536,
      "height": 1024,
      "minWidth": 1050,
      "minHeight": 720,
      "backgroundColor": "#151a1e",
      "useHttpsScheme": true
    }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": ["nsis"] }
}
